<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Maple City Sport & Spine — My Program</title>
<style>
  :root{
    --paper:#faf7f0; --ink:#1c1a16; --sub:#726b5c; --line:#e6ddc9;
    --card:#ffffff; --accent:#fbb52f; --navy:#10141b; --maple:#ab4020;
  }
  @media (prefers-color-scheme: dark){
    :root{ --paper:#0d0f14; --ink:#eae6dc; --sub:#9b9484; --line:#26241f; --card:#16181f; }
  }
  *{box-sizing:border-box}
  body{margin:0;min-height:100vh;background:var(--paper);color:var(--ink);
    font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    display:flex;flex-direction:column}
  .hero{background:linear-gradient(135deg,var(--navy),var(--accent));color:#fff;padding:34px 20px 30px;text-align:center}
  .hero h1{margin:0 0 4px;font-size:21px}
  .hero p{margin:0;opacity:.85;font-size:13.5px}
  .wrap{flex:1;max-width:420px;margin:0 auto;width:100%;padding:26px 18px 60px}
  #login-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 20px;box-shadow:0 1px 2px rgba(0,0,0,.04)}
  #login-card label{display:block;font-size:12.5px;font-weight:700;color:var(--sub);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px}
  #code-input{width:100%;font:700 22px/1.2 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.12em;
    text-align:center;text-transform:uppercase;padding:14px 10px;border:1.5px solid var(--line);border-radius:10px;
    background:var(--paper);color:var(--ink)}
  #code-input:focus{outline:none;border-color:var(--accent)}
  #login-btn{width:100%;margin-top:14px;padding:13px;border:none;border-radius:10px;background:var(--navy);color:#fff;
    font-weight:700;font-size:15px;cursor:pointer}
  #login-btn:disabled{opacity:.5;cursor:default}
  #error-msg{color:var(--maple);font-size:13px;margin:12px 0 0;text-align:center;display:none}
  #login-hint{color:var(--sub);font-size:12px;margin:14px 0 0;text-align:center}
  #page-frame{border:none;width:100%;min-height:100vh;display:none}
  .spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:99px;
    display:inline-block;animation:spin .7s linear infinite;vertical-align:-3px;margin-right:7px}
  @keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<div id="login-view">
  <div class="hero">
    <h1>Maple City Sport & Spine</h1>
    <p>Your Home Exercise Program</p>
  </div>
  <div class="wrap">
    <div id="login-card">
      <label for="code-input">Enter your program code</label>
      <input id="code-input" maxlength="10" autocomplete="off" autocapitalize="characters" placeholder="e.g. NTWZZS" inputmode="text">
      <button id="login-btn">View my program</button>
      <p id="error-msg">We couldn't find a program for that code. Double-check it and try again, or contact the clinic.</p>
    </div>
    <p id="login-hint">Your clinician gave you this code when they set up your program.</p>
  </div>
</div>

<iframe id="page-frame" title="Your exercise program"></iframe>

<!-- Supabase's client library — safe to load from a CDN on a normal website (this isn't a sandboxed Claude Artifact) -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="config.js"></script>
<script>
(function(){
  // config.js (next to this file) defines window.PORTAL_CONFIG = { url, anonKey }
  var cfg = window.PORTAL_CONFIG || {};
  var supabase = (cfg.url && cfg.anonKey)
    ? window.supabase.createClient(cfg.url, cfg.anonKey)
    : null;

  var loginView = document.getElementById('login-view');
  var frame = document.getElementById('page-frame');
  var input = document.getElementById('code-input');
  var btn = document.getElementById('login-btn');
  var err = document.getElementById('error-msg');

  function setBusy(busy){
    btn.disabled = busy;
    btn.innerHTML = busy ? '<span class="spinner"></span>Looking up…' : 'View my program';
  }

  async function tryCode(code){
    if(!code) return;
    err.style.display = 'none';
    if(!supabase){
      err.textContent = 'This page isn\'t fully set up yet (missing config.js values) — contact the clinic.';
      err.style.display = 'block';
      return;
    }
    setBusy(true);
    try{
      var res = await supabase.rpc('get_patient_page', { p_code: code });
      setBusy(false);
      var row = res.data && res.data[0];
      if(res.error || !row){
        err.style.display = 'block';
        return;
      }
      try { sessionStorage.setItem('mchep_code', code); } catch(e){}
      frame.srcdoc = row.html;
      loginView.style.display = 'none';
      frame.style.display = 'block';
    }catch(e){
      setBusy(false);
      err.textContent = 'Something went wrong loading your program. Please try again in a moment.';
      err.style.display = 'block';
    }
  }

  btn.addEventListener('click', function(){ tryCode(input.value.trim().toUpperCase()); });
  input.addEventListener('keydown', function(e){ if(e.key === 'Enter') btn.click(); });
  input.addEventListener('input', function(){ input.value = input.value.toUpperCase(); });

  // If this browser tab already unlocked a code this session, skip straight to it.
  try{
    var remembered = sessionStorage.getItem('mchep_code');
    if(remembered){ input.value = remembered; tryCode(remembered); }
  }catch(e){}
})();
</script>
</body>
</html>
